# Terraform working directory — never commit
.terraform/

# Lock file SHOULD be committed — pins provider versions for reproducibility
# .terraform.lock.hcl   <-- intentionally NOT ignored

# State files — never commit (contains secrets + live infra addresses)
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
crash.log

# Plan binaries and JSON — generated by pipeline, uploaded to S3 evidence vault
terraform/tfplan.binary
terraform/tfplan.json
tfplan
*.tfplan

# Lambda build artifact — regenerated by archive_file data source
terraform/lambda/handler.zip

# Local evidence captures
evidence/

# OS artifacts
.DS_Store
Thumbs.db
